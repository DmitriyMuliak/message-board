# Secret used to sign/verify the mock session JWT (HS256, via `jose`). Any
# long random string works for local dev — generate one with
# `openssl rand -base64 32`. Every seeded user logs in with the password
# "dispatch" (see src/server/credentials-service.ts) regardless of this value.
SESSION_SECRET=change-me-to-a-long-random-string

# Simulated network latency (ms) added to every /api/** response or place where we get data,
# jittered +/-50% so pending/skeleton UI states are actually reviewable. Set to 0 to
# disable (tests set this to 0 for speed and determinism).
MOCK_LATENCY_MS=400

# Random chance (0-1) that a mutation (POST/PATCH/DELETE /api/messages*)
# fails with a simulated 503, on top of the deterministic "#fail" trigger
# (include the literal text "#fail" in a message to force a 503 on demand).
# Default 0 (off), so ordinary use/tests stay deterministic unless enabled.
MOCK_FAILURE_RATE=0
